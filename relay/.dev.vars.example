# Copy to relay/.dev.vars (gitignored) for `npm run relay:dev`; Wrangler loads it as the Worker's local secrets.
#
# SESSION_SIGNING_KEY signs guests' preview cookies (HMAC-SHA256) and must be at least 32 characters. The value below
# is for running the relay on your own machine only. A deployed relay gets its own random key, never this one:
#   openssl rand -base64 32 | npx wrangler secret put SESSION_SIGNING_KEY --config relay/wrangler.toml
# Without a usable key the relay refuses to open rooms, admit guests to the preview or serve it.
SESSION_SIGNING_KEY=local-development-signing-key-not-for-production
