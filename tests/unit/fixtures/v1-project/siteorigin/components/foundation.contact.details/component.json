{
  "schemaVersion": 1,
  "id": "foundation.contact.details",
  "componentId": "contact.details",
  "contractVersion": 1,
  "kind": "managed",
  "owner": "theme",
  "name": "Contact details",
  "description": "Email, telephone, address and opening hours with an optional action. There is no form.",
  "category": "conversion",
  "tags": [
    "contact",
    "email",
    "phone",
    "address",
    "location",
    "hours",
    "get in touch"
  ],
  "icon": "contact",
  "properties": {
    "eyebrow": {
      "type": "string",
      "label": "Eyebrow",
      "default": "Contact"
    },
    "heading": {
      "type": "string",
      "label": "Heading",
      "default": "Let’s talk about your project"
    },
    "lead": {
      "type": "string",
      "label": "Supporting text",
      "default": "The quickest way to reach us is by email or phone. We reply to every enquiry within two working days.",
      "multiline": true
    },
    "items": {
      "type": "list",
      "label": "Contact methods",
      "itemLabel": "Contact method",
      "fields": {
        "icon": {
          "type": "icon",
          "label": "Icon",
          "default": "mail"
        },
        "label": {
          "type": "string",
          "label": "Label",
          "default": "Email"
        },
        "value": {
          "type": "string",
          "label": "Value",
          "default": "hello@example.com"
        },
        "link": {
          "type": "link",
          "label": "Link",
          "default": {
            "type": "none",
            "target": ""
          }
        }
      },
      "default": [
        {
          "id": "item-1",
          "icon": "mail",
          "label": "Email",
          "value": "hello@example.com",
          "link": {
            "type": "email",
            "target": "hello@example.com"
          }
        },
        {
          "id": "item-2",
          "icon": "phone",
          "label": "Phone",
          "value": "+1 555 0134",
          "link": {
            "type": "tel",
            "target": "+15550134"
          }
        },
        {
          "id": "item-3",
          "icon": "map-pin",
          "label": "Studio",
          "value": "12 Harbour Lane, Millbrook",
          "link": {
            "type": "none",
            "target": ""
          }
        },
        {
          "id": "item-4",
          "icon": "clock",
          "label": "Hours",
          "value": "Monday to Friday, 9am – 5pm",
          "link": {
            "type": "none",
            "target": ""
          }
        }
      ],
      "max": 8,
      "titleField": "label"
    },
    "actionLabel": {
      "type": "string",
      "label": "Action label",
      "default": "Email us"
    },
    "actionLink": {
      "type": "link",
      "label": "Action link",
      "default": {
        "type": "email",
        "target": "hello@example.com"
      }
    }
  },
  "parts": {
    "root": {
      "nodeId": "root",
      "label": "Section",
      "styleControls": [
        "paddingBlock",
        "background"
      ]
    },
    "heading": {
      "nodeId": "heading",
      "label": "Heading",
      "styleControls": [
        "textStyle",
        "color"
      ]
    },
    "list": {
      "nodeId": "list",
      "label": "Contact list",
      "styleControls": [
        "gap",
        "columns"
      ]
    },
    "method": {
      "nodeId": "method",
      "label": "Contact method",
      "styleControls": [
        "background",
        "border",
        "radius"
      ]
    }
  },
  "variants": {
    "default": {
      "label": "Default"
    },
    "muted": {
      "label": "Soft background",
      "styles": {
        "root": {
          "base": {
            "background": {
              "token": "color.surface-alt"
            }
          }
        }
      }
    },
    "inverse": {
      "label": "Dark",
      "styles": {
        "root": {
          "base": {
            "background": {
              "token": "color.inverse"
            },
            "color": {
              "token": "color.on-inverse"
            }
          }
        },
        "eyebrow": {
          "base": {
            "color": {
              "token": "color.accent"
            }
          }
        },
        "lead": {
          "base": {
            "color": {
              "token": "color.on-inverse"
            },
            "opacity": 0.78
          }
        }
      }
    }
  },
  "defaultVariant": "default",
  "tree": {
    "rootIds": [
      "root"
    ],
    "nodes": {
      "eyebrow": {
        "id": "eyebrow",
        "kind": "text",
        "tag": "p",
        "text": {
          "$prop": "eyebrow"
        },
        "styles": {
          "base": {
            "textStyle": {
              "token": "text.eyebrow"
            },
            "color": {
              "token": "color.brand"
            }
          }
        },
        "when": {
          "$prop": "eyebrow"
        },
        "name": "Eyebrow"
      },
      "heading": {
        "id": "heading",
        "kind": "text",
        "tag": "h2",
        "text": {
          "$prop": "heading"
        },
        "styles": {
          "base": {
            "textStyle": {
              "token": "text.h2"
            }
          }
        },
        "name": "Heading"
      },
      "lead": {
        "id": "lead",
        "kind": "text",
        "tag": "p",
        "text": {
          "$prop": "lead"
        },
        "styles": {
          "base": {
            "textStyle": {
              "token": "text.lead"
            },
            "color": {
              "token": "color.muted"
            }
          }
        },
        "when": {
          "$prop": "lead"
        },
        "name": "Lead"
      },
      "intro": {
        "id": "intro",
        "kind": "element",
        "tag": "div",
        "children": [
          "eyebrow",
          "heading",
          "lead"
        ],
        "styles": {
          "base": {
            "layout": "stack",
            "gap": {
              "token": "space.md"
            },
            "maxWidth": "760px",
            "textAlign": "start"
          }
        },
        "name": "Heading group"
      },
      "action": {
        "id": "action",
        "kind": "link",
        "link": {
          "$prop": "actionLink"
        },
        "label": {
          "$prop": "actionLabel"
        },
        "appearance": "primary",
        "when": {
          "$prop": "actionLabel"
        },
        "name": "Action"
      },
      "content": {
        "id": "content",
        "kind": "element",
        "tag": "div",
        "children": [
          "intro",
          "action"
        ],
        "styles": {
          "base": {
            "layout": "stack",
            "gap": {
              "token": "space.lg"
            },
            "align": "start"
          }
        },
        "name": "Content"
      },
      "method-icon": {
        "id": "method-icon",
        "kind": "icon",
        "icon": {
          "$item": "icon"
        },
        "name": "Icon"
      },
      "method-icon-wrap": {
        "id": "method-icon-wrap",
        "kind": "element",
        "tag": "div",
        "children": [
          "method-icon"
        ],
        "styles": {
          "base": {
            "layout": "row",
            "align": "center",
            "justify": "center",
            "width": "40px",
            "minHeight": "40px",
            "radius": {
              "token": "radius.pill"
            },
            "background": "color-mix(in srgb, var(--so-color-brand) 10%, transparent)",
            "color": {
              "token": "color.brand"
            }
          }
        },
        "name": "Icon badge"
      },
      "method-label": {
        "id": "method-label",
        "kind": "text",
        "tag": "span",
        "text": {
          "$item": "label"
        },
        "styles": {
          "base": {
            "textStyle": {
              "token": "text.small"
            },
            "color": {
              "token": "color.muted"
            }
          }
        },
        "name": "Label"
      },
      "method-value": {
        "id": "method-value",
        "kind": "link",
        "link": {
          "$item": "link"
        },
        "label": {
          "$item": "value"
        },
        "appearance": "plain",
        "styles": {
          "base": {
            "fontWeight": "550",
            "color": {
              "token": "color.text"
            }
          }
        },
        "name": "Value"
      },
      "method-text": {
        "id": "method-text",
        "kind": "element",
        "tag": "div",
        "children": [
          "method-label",
          "method-value"
        ],
        "styles": {
          "base": {
            "layout": "stack",
            "gap": "2px"
          }
        },
        "name": "Text"
      },
      "method": {
        "id": "method",
        "kind": "element",
        "tag": "li",
        "children": [
          "method-icon-wrap",
          "method-text"
        ],
        "styles": {
          "base": {
            "layout": "row",
            "align": "start",
            "gap": {
              "token": "space.md"
            },
            "paddingBlock": {
              "token": "space.lg"
            },
            "paddingInline": {
              "token": "space.lg"
            },
            "background": {
              "token": "color.surface"
            },
            "color": {
              "token": "color.text"
            },
            "border": {
              "token": "border.default"
            },
            "radius": {
              "token": "radius.md"
            }
          }
        },
        "name": "Contact method"
      },
      "methods": {
        "id": "methods",
        "kind": "repeat",
        "list": {
          "$prop": "items"
        },
        "children": [
          "method"
        ]
      },
      "list": {
        "id": "list",
        "kind": "element",
        "tag": "ul",
        "children": [
          "methods"
        ],
        "styles": {
          "base": {
            "layout": "grid",
            "columns": 1,
            "gap": {
              "token": "space.md"
            }
          },
          "tablet": {
            "columns": 2
          }
        },
        "name": "Contact list"
      },
      "grid": {
        "id": "grid",
        "kind": "element",
        "tag": "div",
        "children": [
          "content",
          "list"
        ],
        "styles": {
          "base": {
            "layout": "grid",
            "columns": 1,
            "gap": {
              "token": "space.2xl"
            }
          },
          "desktop": {
            "columns": 2,
            "gap": {
              "token": "space.3xl"
            }
          }
        },
        "name": "Layout"
      },
      "inner": {
        "id": "inner",
        "kind": "element",
        "tag": "div",
        "children": [
          "grid"
        ],
        "styles": {
          "base": {
            "layout": "stack",
            "gap": {
              "token": "space.2xl"
            },
            "width": "fill",
            "maxWidth": {
              "token": "container.content"
            },
            "marginInline": "auto"
          }
        },
        "name": "Container"
      },
      "root": {
        "id": "root",
        "kind": "element",
        "tag": "section",
        "children": [
          "inner"
        ],
        "styles": {
          "base": {
            "paddingBlock": {
              "token": "space.section"
            },
            "paddingInline": {
              "token": "container.gutter"
            },
            "background": {
              "token": "color.background"
            },
            "color": {
              "token": "color.text"
            }
          }
        },
        "name": "Section"
      }
    }
  },
  "provenance": {
    "pack": "foundation",
    "packVersion": "0.1.0",
    "componentId": "contact.details"
  },
  "license": "GPL-3.0-or-later"
}
