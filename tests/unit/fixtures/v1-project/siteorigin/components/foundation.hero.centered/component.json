{
  "schemaVersion": 1,
  "id": "foundation.hero.centered",
  "componentId": "hero.centered",
  "contractVersion": 1,
  "kind": "managed",
  "owner": "theme",
  "name": "Centered hero",
  "description": "A centered introduction with a large heading, supporting copy and up to two actions.",
  "category": "hero",
  "tags": [
    "hero",
    "banner",
    "intro",
    "headline",
    "landing",
    "top"
  ],
  "icon": "text-align-center",
  "properties": {
    "eyebrow": {
      "type": "string",
      "label": "Eyebrow",
      "default": "Independent studio"
    },
    "heading": {
      "type": "string",
      "label": "Heading",
      "default": "Thoughtful work for people who care about the details"
    },
    "lead": {
      "type": "string",
      "label": "Supporting text",
      "default": "We help small teams plan, design and deliver projects that feel considered from the first conversation to the final handover.",
      "multiline": true
    },
    "primaryLabel": {
      "type": "string",
      "label": "Primary button label",
      "default": "Start a project"
    },
    "primaryLink": {
      "type": "link",
      "label": "Primary button link",
      "default": {
        "type": "none",
        "target": ""
      }
    },
    "secondaryLabel": {
      "type": "string",
      "label": "Secondary button label",
      "default": "See our work"
    },
    "secondaryLink": {
      "type": "link",
      "label": "Secondary button link",
      "default": {
        "type": "none",
        "target": ""
      }
    }
  },
  "parts": {
    "root": {
      "nodeId": "root",
      "label": "Section",
      "styleControls": [
        "paddingBlock",
        "background",
        "color",
        "minHeight"
      ]
    },
    "container": {
      "nodeId": "inner",
      "label": "Container",
      "styleControls": [
        "maxWidth",
        "gap",
        "align"
      ]
    },
    "eyebrow": {
      "nodeId": "eyebrow",
      "label": "Eyebrow",
      "styleControls": [
        "textStyle",
        "color"
      ]
    },
    "heading": {
      "nodeId": "heading",
      "label": "Heading",
      "styleControls": [
        "textStyle",
        "color",
        "maxWidth",
        "textAlign"
      ]
    },
    "lead": {
      "nodeId": "lead",
      "label": "Supporting text",
      "styleControls": [
        "textStyle",
        "color",
        "maxWidth"
      ]
    },
    "actions": {
      "nodeId": "actions",
      "label": "Actions",
      "styleControls": [
        "gap",
        "justify"
      ]
    }
  },
  "variants": {
    "default": {
      "label": "Default"
    },
    "muted": {
      "label": "Soft background",
      "styles": {
        "root": {
          "base": {
            "background": {
              "token": "color.surface-alt"
            }
          }
        }
      }
    },
    "inverse": {
      "label": "Dark",
      "styles": {
        "root": {
          "base": {
            "background": {
              "token": "color.inverse"
            },
            "color": {
              "token": "color.on-inverse"
            }
          }
        },
        "eyebrow": {
          "base": {
            "color": {
              "token": "color.accent"
            }
          }
        },
        "lead": {
          "base": {
            "color": {
              "token": "color.on-inverse"
            },
            "opacity": 0.78
          }
        }
      }
    },
    "brand": {
      "label": "Brand",
      "styles": {
        "root": {
          "base": {
            "background": {
              "token": "color.brand"
            },
            "color": {
              "token": "color.on-brand"
            }
          }
        },
        "eyebrow": {
          "base": {
            "color": {
              "token": "color.on-brand"
            },
            "opacity": 0.8
          }
        },
        "lead": {
          "base": {
            "color": {
              "token": "color.on-brand"
            },
            "opacity": 0.85
          }
        },
        "primary": {
          "base": {
            "background": {
              "token": "color.on-brand"
            },
            "color": {
              "token": "color.brand-strong"
            }
          }
        }
      }
    }
  },
  "defaultVariant": "default",
  "tree": {
    "rootIds": [
      "root"
    ],
    "nodes": {
      "eyebrow": {
        "id": "eyebrow",
        "kind": "text",
        "tag": "p",
        "text": {
          "$prop": "eyebrow"
        },
        "styles": {
          "base": {
            "textStyle": {
              "token": "text.eyebrow"
            },
            "color": {
              "token": "color.brand"
            }
          }
        },
        "when": {
          "$prop": "eyebrow"
        },
        "name": "Eyebrow"
      },
      "heading": {
        "id": "heading",
        "kind": "text",
        "tag": "h1",
        "text": {
          "$prop": "heading"
        },
        "styles": {
          "base": {
            "textStyle": {
              "token": "text.display"
            }
          }
        },
        "name": "Heading"
      },
      "lead": {
        "id": "lead",
        "kind": "text",
        "tag": "p",
        "text": {
          "$prop": "lead"
        },
        "styles": {
          "base": {
            "textStyle": {
              "token": "text.lead"
            },
            "color": {
              "token": "color.muted"
            },
            "maxWidth": "640px"
          }
        },
        "when": {
          "$prop": "lead"
        },
        "name": "Supporting text"
      },
      "primary": {
        "id": "primary",
        "kind": "link",
        "link": {
          "$prop": "primaryLink"
        },
        "label": {
          "$prop": "primaryLabel"
        },
        "appearance": "primary",
        "when": {
          "$prop": "primaryLabel"
        },
        "name": "Primary button"
      },
      "secondary": {
        "id": "secondary",
        "kind": "link",
        "link": {
          "$prop": "secondaryLink"
        },
        "label": {
          "$prop": "secondaryLabel"
        },
        "appearance": "secondary",
        "when": {
          "$prop": "secondaryLabel"
        },
        "name": "Secondary button"
      },
      "actions": {
        "id": "actions",
        "kind": "element",
        "tag": "div",
        "children": [
          "primary",
          "secondary"
        ],
        "styles": {
          "base": {
            "layout": "row",
            "wrap": true,
            "gap": {
              "token": "space.sm"
            },
            "justify": "center",
            "marginBlockStart": {
              "token": "space.sm"
            }
          }
        },
        "name": "Actions"
      },
      "content": {
        "id": "content",
        "kind": "element",
        "tag": "div",
        "children": [
          "eyebrow",
          "heading",
          "lead",
          "actions"
        ],
        "styles": {
          "base": {
            "layout": "stack",
            "gap": {
              "token": "space.lg"
            },
            "align": "center",
            "textAlign": "center",
            "maxWidth": "880px",
            "marginInline": "auto"
          }
        },
        "name": "Content"
      },
      "inner": {
        "id": "inner",
        "kind": "element",
        "tag": "div",
        "children": [
          "content"
        ],
        "styles": {
          "base": {
            "layout": "stack",
            "gap": {
              "token": "space.2xl"
            },
            "width": "fill",
            "maxWidth": {
              "token": "container.content"
            },
            "marginInline": "auto"
          }
        },
        "name": "Container"
      },
      "root": {
        "id": "root",
        "kind": "element",
        "tag": "section",
        "children": [
          "inner"
        ],
        "styles": {
          "base": {
            "paddingBlock": "clamp(5rem, 3.5rem + 7vw, 10rem)",
            "paddingInline": {
              "token": "container.gutter"
            },
            "background": {
              "token": "color.background"
            },
            "color": {
              "token": "color.text"
            }
          }
        },
        "name": "Section"
      }
    }
  },
  "provenance": {
    "pack": "foundation",
    "packVersion": "0.1.0",
    "componentId": "hero.centered"
  },
  "license": "GPL-3.0-or-later",
  "examples": [
    {
      "description": "Home page introduction for a design studio",
      "props": {
        "heading": "Spaces that feel like home",
        "primaryLabel": "Book a consultation"
      }
    }
  ]
}
