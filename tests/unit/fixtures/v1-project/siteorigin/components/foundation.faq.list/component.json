{
  "schemaVersion": 1,
  "id": "foundation.faq.list",
  "componentId": "faq.list",
  "contractVersion": 1,
  "kind": "managed",
  "owner": "theme",
  "name": "FAQ",
  "description": "Frequently asked questions with accessible expandable answers.",
  "category": "conversion",
  "tags": [
    "faq",
    "questions",
    "answers",
    "accordion",
    "help",
    "support"
  ],
  "icon": "circle-question-mark",
  "properties": {
    "eyebrow": {
      "type": "string",
      "label": "Eyebrow",
      "default": "Questions"
    },
    "heading": {
      "type": "string",
      "label": "Heading",
      "default": "Frequently asked questions"
    },
    "lead": {
      "type": "string",
      "label": "Supporting text",
      "default": "Cannot find what you are looking for? Get in touch and we will be happy to help.",
      "multiline": true
    },
    "items": {
      "type": "list",
      "label": "Questions",
      "itemLabel": "Question",
      "fields": {
        "question": {
          "type": "string",
          "label": "Question",
          "default": "Question?"
        },
        "answer": {
          "type": "string",
          "label": "Answer",
          "default": "Answer.",
          "multiline": true
        }
      },
      "default": [
        {
          "id": "item-1",
          "question": "How long does a typical project take?",
          "answer": "Most design projects take six to ten weeks from the first meeting to final drawings. We agree a schedule with you at the start."
        },
        {
          "id": "item-2",
          "question": "Do you work outside the local area?",
          "answer": "Yes. We regularly work across the region and can arrange remote consultations for early planning."
        },
        {
          "id": "item-3",
          "question": "How are your fees calculated?",
          "answer": "We quote a fixed fee for each stage once we understand the scope, so you always know the cost before work begins."
        },
        {
          "id": "item-4",
          "question": "Can you recommend builders?",
          "answer": "We work with a small group of trusted contractors and are happy to introduce them, or to work with your own builder."
        }
      ],
      "max": 30,
      "titleField": "question"
    }
  },
  "parts": {
    "root": {
      "nodeId": "root",
      "label": "Section",
      "styleControls": [
        "paddingBlock",
        "background"
      ]
    },
    "heading": {
      "nodeId": "heading",
      "label": "Heading",
      "styleControls": [
        "textStyle",
        "color"
      ]
    },
    "item": {
      "nodeId": "item",
      "label": "Question",
      "styleControls": [
        "background",
        "border",
        "radius"
      ]
    },
    "question": {
      "nodeId": "question",
      "label": "Question text",
      "styleControls": [
        "textStyle",
        "color"
      ]
    },
    "answer": {
      "nodeId": "answer",
      "label": "Answer",
      "styleControls": [
        "textStyle",
        "color"
      ]
    }
  },
  "variants": {
    "default": {
      "label": "Default"
    },
    "muted": {
      "label": "Soft background",
      "styles": {
        "root": {
          "base": {
            "background": {
              "token": "color.surface-alt"
            }
          }
        }
      }
    },
    "inverse": {
      "label": "Dark",
      "styles": {
        "root": {
          "base": {
            "background": {
              "token": "color.inverse"
            },
            "color": {
              "token": "color.on-inverse"
            }
          }
        },
        "eyebrow": {
          "base": {
            "color": {
              "token": "color.accent"
            }
          }
        },
        "lead": {
          "base": {
            "color": {
              "token": "color.on-inverse"
            },
            "opacity": 0.78
          }
        },
        "answer": {
          "base": {
            "color": {
              "token": "color.on-inverse"
            },
            "opacity": 0.78
          }
        },
        "toggle-icon": {
          "base": {
            "color": {
              "token": "color.accent"
            }
          }
        }
      }
    }
  },
  "defaultVariant": "default",
  "tree": {
    "rootIds": [
      "root"
    ],
    "nodes": {
      "eyebrow": {
        "id": "eyebrow",
        "kind": "text",
        "tag": "p",
        "text": {
          "$prop": "eyebrow"
        },
        "styles": {
          "base": {
            "textStyle": {
              "token": "text.eyebrow"
            },
            "color": {
              "token": "color.brand"
            }
          }
        },
        "when": {
          "$prop": "eyebrow"
        },
        "name": "Eyebrow"
      },
      "heading": {
        "id": "heading",
        "kind": "text",
        "tag": "h2",
        "text": {
          "$prop": "heading"
        },
        "styles": {
          "base": {
            "textStyle": {
              "token": "text.h2"
            }
          }
        },
        "name": "Heading"
      },
      "lead": {
        "id": "lead",
        "kind": "text",
        "tag": "p",
        "text": {
          "$prop": "lead"
        },
        "styles": {
          "base": {
            "textStyle": {
              "token": "text.lead"
            },
            "color": {
              "token": "color.muted"
            }
          }
        },
        "when": {
          "$prop": "lead"
        },
        "name": "Lead"
      },
      "intro": {
        "id": "intro",
        "kind": "element",
        "tag": "div",
        "children": [
          "eyebrow",
          "heading",
          "lead"
        ],
        "styles": {
          "base": {
            "layout": "stack",
            "gap": {
              "token": "space.md"
            },
            "maxWidth": "760px",
            "textAlign": "start"
          }
        },
        "name": "Heading group"
      },
      "question": {
        "id": "question",
        "kind": "text",
        "tag": "span",
        "text": {
          "$item": "question"
        },
        "styles": {
          "base": {
            "textStyle": {
              "token": "text.h3"
            },
            "fontWeight": "550"
          }
        },
        "name": "Question text"
      },
      "toggle-icon": {
        "id": "toggle-icon",
        "kind": "icon",
        "icon": "plus",
        "styles": {
          "base": {
            "color": {
              "token": "color.brand"
            },
            "fontSize": "1.3rem"
          }
        },
        "name": "Toggle icon"
      },
      "summary": {
        "id": "summary",
        "kind": "element",
        "tag": "summary",
        "children": [
          "question",
          "toggle-icon"
        ],
        "styles": {
          "base": {
            "layout": "row",
            "justify": "space-between",
            "align": "center",
            "gap": {
              "token": "space.lg"
            },
            "paddingBlock": {
              "token": "space.lg"
            },
            "border": "0"
          }
        },
        "name": "Summary"
      },
      "answer": {
        "id": "answer",
        "kind": "text",
        "tag": "p",
        "text": {
          "$item": "answer"
        },
        "styles": {
          "base": {
            "color": {
              "token": "color.muted"
            },
            "paddingBlock": "0",
            "marginBlockEnd": {
              "token": "space.lg"
            },
            "maxWidth": "68ch"
          }
        },
        "name": "Answer"
      },
      "item": {
        "id": "item",
        "kind": "element",
        "tag": "details",
        "children": [
          "summary",
          "answer"
        ],
        "name": "Question"
      },
      "item-divider": {
        "id": "item-divider",
        "kind": "divider",
        "name": "Divider"
      },
      "questions": {
        "id": "questions",
        "kind": "repeat",
        "list": {
          "$prop": "items"
        },
        "children": [
          "item",
          "item-divider"
        ]
      },
      "list": {
        "id": "list",
        "kind": "element",
        "tag": "div",
        "children": [
          "questions"
        ],
        "styles": {
          "base": {
            "layout": "stack",
            "gap": "0",
            "border": "0"
          }
        },
        "name": "Questions"
      },
      "inner": {
        "id": "inner",
        "kind": "element",
        "tag": "div",
        "children": [
          "intro",
          "list"
        ],
        "styles": {
          "base": {
            "layout": "stack",
            "gap": {
              "token": "space.2xl"
            },
            "width": "fill",
            "maxWidth": {
              "token": "container.reading"
            },
            "marginInline": "auto"
          }
        },
        "name": "Container"
      },
      "root": {
        "id": "root",
        "kind": "element",
        "tag": "section",
        "children": [
          "inner"
        ],
        "styles": {
          "base": {
            "paddingBlock": {
              "token": "space.section"
            },
            "paddingInline": {
              "token": "container.gutter"
            },
            "background": {
              "token": "color.background"
            },
            "color": {
              "token": "color.text"
            }
          }
        },
        "name": "Section"
      }
    }
  },
  "provenance": {
    "pack": "foundation",
    "packVersion": "0.1.0",
    "componentId": "faq.list"
  },
  "license": "GPL-3.0-or-later"
}
