{
  "schemaVersion": 1,
  "id": "foundation.features.grid",
  "componentId": "features.grid",
  "contractVersion": 1,
  "kind": "managed",
  "owner": "theme",
  "name": "Services grid",
  "description": "A heading followed by repeatable cards, each with an icon, title, description and optional link. Use for services, features or benefits.",
  "category": "content",
  "tags": [
    "services",
    "features",
    "cards",
    "grid",
    "benefits",
    "offerings",
    "what we do"
  ],
  "icon": "layout-grid",
  "properties": {
    "eyebrow": {
      "type": "string",
      "label": "Eyebrow",
      "default": "What we do"
    },
    "heading": {
      "type": "string",
      "label": "Heading",
      "default": "Services shaped around your project"
    },
    "lead": {
      "type": "string",
      "label": "Supporting text",
      "default": "Every engagement is different. These are the ways we most often help.",
      "multiline": true
    },
    "items": {
      "type": "list",
      "label": "Cards",
      "itemLabel": "Card",
      "fields": {
        "icon": {
          "type": "icon",
          "label": "Icon",
          "default": "sparkles"
        },
        "title": {
          "type": "string",
          "label": "Title",
          "default": "Service"
        },
        "description": {
          "type": "string",
          "label": "Description",
          "default": "Describe what this service includes and who it is for.",
          "multiline": true
        },
        "linkLabel": {
          "type": "string",
          "label": "Link label",
          "default": ""
        },
        "link": {
          "type": "link",
          "label": "Link",
          "default": {
            "type": "none",
            "target": ""
          }
        }
      },
      "default": [
        {
          "id": "item-1",
          "icon": "compass",
          "title": "Planning",
          "description": "Clear priorities, a realistic budget and a schedule everyone understands before work begins.",
          "linkLabel": "",
          "link": {
            "type": "none",
            "target": ""
          }
        },
        {
          "id": "item-2",
          "icon": "pen-tool",
          "title": "Design",
          "description": "Considered layouts, materials and details developed with you through focused reviews.",
          "linkLabel": "",
          "link": {
            "type": "none",
            "target": ""
          }
        },
        {
          "id": "item-3",
          "icon": "hammer",
          "title": "Delivery",
          "description": "We coordinate trusted specialists and keep you informed at every stage of the build.",
          "linkLabel": "",
          "link": {
            "type": "none",
            "target": ""
          }
        }
      ],
      "max": 12,
      "titleField": "title"
    }
  },
  "parts": {
    "root": {
      "nodeId": "root",
      "label": "Section",
      "styleControls": [
        "paddingBlock",
        "background"
      ]
    },
    "heading": {
      "nodeId": "heading",
      "label": "Heading",
      "styleControls": [
        "textStyle",
        "color"
      ]
    },
    "grid": {
      "nodeId": "grid",
      "label": "Card grid",
      "styleControls": [
        "columns",
        "gap"
      ]
    },
    "card": {
      "nodeId": "card",
      "label": "Card",
      "styleControls": [
        "background",
        "border",
        "radius",
        "shadow",
        "paddingBlock",
        "paddingInline"
      ]
    },
    "cardTitle": {
      "nodeId": "card-title",
      "label": "Card title",
      "styleControls": [
        "textStyle",
        "color"
      ]
    },
    "cardIcon": {
      "nodeId": "card-icon",
      "label": "Card icon",
      "styleControls": [
        "color",
        "background"
      ]
    }
  },
  "variants": {
    "default": {
      "label": "Default"
    },
    "muted": {
      "label": "Soft background",
      "styles": {
        "root": {
          "base": {
            "background": {
              "token": "color.surface-alt"
            }
          }
        }
      }
    },
    "inverse": {
      "label": "Dark",
      "styles": {
        "root": {
          "base": {
            "background": {
              "token": "color.inverse"
            },
            "color": {
              "token": "color.on-inverse"
            }
          }
        },
        "eyebrow": {
          "base": {
            "color": {
              "token": "color.accent"
            }
          }
        },
        "lead": {
          "base": {
            "color": {
              "token": "color.on-inverse"
            },
            "opacity": 0.78
          }
        }
      }
    },
    "two-columns": {
      "label": "Two columns",
      "styles": {
        "grid": {
          "desktop": {
            "columns": 2
          }
        }
      }
    },
    "four-columns": {
      "label": "Four columns",
      "styles": {
        "grid": {
          "desktop": {
            "columns": 4
          }
        }
      }
    }
  },
  "defaultVariant": "default",
  "tree": {
    "rootIds": [
      "root"
    ],
    "nodes": {
      "eyebrow": {
        "id": "eyebrow",
        "kind": "text",
        "tag": "p",
        "text": {
          "$prop": "eyebrow"
        },
        "styles": {
          "base": {
            "textStyle": {
              "token": "text.eyebrow"
            },
            "color": {
              "token": "color.brand"
            }
          }
        },
        "when": {
          "$prop": "eyebrow"
        },
        "name": "Eyebrow"
      },
      "heading": {
        "id": "heading",
        "kind": "text",
        "tag": "h2",
        "text": {
          "$prop": "heading"
        },
        "styles": {
          "base": {
            "textStyle": {
              "token": "text.h2"
            }
          }
        },
        "name": "Heading"
      },
      "lead": {
        "id": "lead",
        "kind": "text",
        "tag": "p",
        "text": {
          "$prop": "lead"
        },
        "styles": {
          "base": {
            "textStyle": {
              "token": "text.lead"
            },
            "color": {
              "token": "color.muted"
            }
          }
        },
        "when": {
          "$prop": "lead"
        },
        "name": "Lead"
      },
      "intro": {
        "id": "intro",
        "kind": "element",
        "tag": "div",
        "children": [
          "eyebrow",
          "heading",
          "lead"
        ],
        "styles": {
          "base": {
            "layout": "stack",
            "gap": {
              "token": "space.md"
            },
            "maxWidth": "760px",
            "textAlign": "start"
          }
        },
        "name": "Heading group"
      },
      "card-icon": {
        "id": "card-icon",
        "kind": "icon",
        "icon": {
          "$item": "icon"
        },
        "name": "Icon"
      },
      "card-icon-wrap": {
        "id": "card-icon-wrap",
        "kind": "element",
        "tag": "div",
        "children": [
          "card-icon"
        ],
        "styles": {
          "base": {
            "layout": "row",
            "align": "center",
            "justify": "center",
            "width": "48px",
            "minHeight": "48px",
            "radius": {
              "token": "radius.md"
            },
            "background": "color-mix(in srgb, var(--so-color-brand) 10%, transparent)",
            "color": {
              "token": "color.brand"
            },
            "fontSize": "1.3rem",
            "marginBlockEnd": {
              "token": "space.xs"
            }
          }
        },
        "name": "Icon badge"
      },
      "card-title": {
        "id": "card-title",
        "kind": "text",
        "tag": "h3",
        "text": {
          "$item": "title"
        },
        "styles": {
          "base": {
            "textStyle": {
              "token": "text.h3"
            }
          }
        },
        "name": "Title"
      },
      "card-text": {
        "id": "card-text",
        "kind": "text",
        "tag": "p",
        "text": {
          "$item": "description"
        },
        "styles": {
          "base": {
            "color": {
              "token": "color.muted"
            }
          }
        },
        "name": "Description"
      },
      "card-link": {
        "id": "card-link",
        "kind": "link",
        "link": {
          "$item": "link"
        },
        "label": {
          "$item": "linkLabel"
        },
        "appearance": "text",
        "styles": {
          "base": {
            "marginBlockStart": "auto"
          }
        },
        "when": {
          "$item": "linkLabel"
        },
        "name": "Link"
      },
      "card": {
        "id": "card",
        "kind": "element",
        "tag": "li",
        "children": [
          "card-icon-wrap",
          "card-title",
          "card-text",
          "card-link"
        ],
        "styles": {
          "base": {
            "layout": "stack",
            "gap": {
              "token": "space.md"
            },
            "paddingBlock": {
              "token": "space.xl"
            },
            "paddingInline": {
              "token": "space.xl"
            },
            "background": {
              "token": "color.surface"
            },
            "color": {
              "token": "color.text"
            },
            "border": {
              "token": "border.default"
            },
            "radius": {
              "token": "radius.lg"
            }
          }
        },
        "name": "Card"
      },
      "cards": {
        "id": "cards",
        "kind": "repeat",
        "list": {
          "$prop": "items"
        },
        "children": [
          "card"
        ]
      },
      "grid": {
        "id": "grid",
        "kind": "element",
        "tag": "ul",
        "children": [
          "cards"
        ],
        "styles": {
          "base": {
            "layout": "grid",
            "columns": 1,
            "gap": {
              "token": "space.lg"
            }
          },
          "tablet": {
            "columns": 2
          },
          "desktop": {
            "columns": 3
          }
        },
        "name": "Card grid"
      },
      "inner": {
        "id": "inner",
        "kind": "element",
        "tag": "div",
        "children": [
          "intro",
          "grid"
        ],
        "styles": {
          "base": {
            "layout": "stack",
            "gap": {
              "token": "space.2xl"
            },
            "width": "fill",
            "maxWidth": {
              "token": "container.content"
            },
            "marginInline": "auto"
          }
        },
        "name": "Container"
      },
      "root": {
        "id": "root",
        "kind": "element",
        "tag": "section",
        "children": [
          "inner"
        ],
        "styles": {
          "base": {
            "paddingBlock": {
              "token": "space.section"
            },
            "paddingInline": {
              "token": "container.gutter"
            },
            "background": {
              "token": "color.background"
            },
            "color": {
              "token": "color.text"
            }
          }
        },
        "name": "Section"
      }
    }
  },
  "provenance": {
    "pack": "foundation",
    "packVersion": "0.1.0",
    "componentId": "features.grid"
  },
  "license": "GPL-3.0-or-later"
}
