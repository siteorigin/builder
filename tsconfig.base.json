{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noUnusedLocals": false,
    "verbatimModuleSyntax": false,
    "types": [],
    "paths": {
      "@shared/*": [
        "./src/shared/*"
      ],
      "@engine/*": [
        "./src/engine/*"
      ],
      "@generator/*": [
        "./src/generator/*"
      ],
      "@catalogue/*": [
        "./src/catalogue/*"
      ],
      "@agent/*": [
        "./src/agent/*"
      ],
      "@runtime/*": [
        "./src/runtime/*"
      ],
      "@renderer/*": [
        "./src/renderer/src/*"
      ]
    }
  }
}